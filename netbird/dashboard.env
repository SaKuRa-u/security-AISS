# Dashboard env — mengikuti render_dashboard_env resmi (embedded IdP).
NETBIRD_MGMT_API_ENDPOINT=https://netbirdoverlay.cloudferdi.web.id
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbirdoverlay.cloudferdi.web.id
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=https://netbirdoverlay.cloudferdi.web.id/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
