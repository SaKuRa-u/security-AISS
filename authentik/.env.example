# Copy ke .env lalu isi secret (jangan commit .env):
#   echo "PG_PASS=$(openssl rand -base64 36 | tr -d '\n')" >> .env
#   echo "AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')" >> .env
AUTH_DOMAIN=auth.cloudferdi.web.id
AUTHENTIK_TAG=2026.8.3
PG_DB=authentik
PG_USER=authentik
PG_PASS=CHANGEME-postgres-password
AUTHENTIK_SECRET_KEY=CHANGEME-authentik-secret-key
LLDAP_BASE_DN=dc=cloudferdi,dc=web,dc=id
LLDAP_ADMIN_PASS=CHANGEME-lldap-admin-password
LLDAP_JWT_SECRET=CHANGEME-lldap-jwt-secret
LLDAP_KEY_SEED=CHANGEME-lldap-key-seed
